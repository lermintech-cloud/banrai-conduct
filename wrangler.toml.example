# ใช้เฉพาะเมื่อติดตั้งด้วยคำสั่ง (CLI) — เปลี่ยนชื่อเป็น wrangler.toml แล้วใส่ database_id
# ถ้าติดตั้งผ่าน GitHub + หน้าเว็บ Cloudflare ไม่ต้องใช้ไฟล์นี้
name = "banrai-conduct"
compatibility_date = "2024-11-01"
pages_build_output_dir = "./public"
[[d1_databases]]
binding = "DB"
database_name = "banrai-conduct"
database_id = "ใส่-database_id"
